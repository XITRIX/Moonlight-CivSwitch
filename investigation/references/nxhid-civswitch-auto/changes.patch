+        self.assertEqual(self.reports(3)[-2:], [nx.RELEASE.hex(), "P"+nx.PAD_NEUTRAL.hex()])
+
+    def test_real_tcp_macro_and_resume_preserve_message_order(self):
+        lines = ['1/2"aA!', '2/2"bb`']
