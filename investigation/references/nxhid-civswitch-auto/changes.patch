+        sock.sendall(b"PAD 04c0098080808001\n")
+        self.assertEqual(self.line(sock), b"")
+        self.assertEqual(self.reports(3)[-2:], [nx.RELEASE.hex(), "P"+nx.PAD_NEUTRAL.hex()])
+
+    def test_watchdog_releases_controller(self):
