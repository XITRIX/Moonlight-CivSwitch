+        if (report.type != (pad ? CMD_PAD : CMD_REPORT)) return (Command){0};
+        memcpy(cmd.report, report.report, 8);
+        cmd.type = pad ? CMD_PAD_TAP : CMD_TAP;
     }
     return cmd;
 }
