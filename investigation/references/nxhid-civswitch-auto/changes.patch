+def read_civ_payload(path):
+    import hashlib
+    raw = path.read_bytes()
+    lines = raw.decode("ascii").splitlines()
+    if not lines or any(not line for line in lines):
+        raise ValueError("Payload must contain indexed CivSwitch chat lines without blanks")
+    for i, line in enumerate(lines, 1):
+        if not line.startswith('%d/%d"' % (i, len(lines))):
+            raise ValueError("Line %d is not a generated CivSwitch chat line" % i)
+        if len(line) + 1 > 254 or any(not 32 <= ord(c) <= 126 for c in line):
+            raise ValueError("Line %d exceeds the size limit or contains control characters" % i)
+        for char in line:
+            character_key(char)
+    return lines, hashlib.sha256(raw).hexdigest()
+
+
+def send_civ(client, lines, start=1, limit=None, preamble=True, countdown=5,
+             hold=0.04, gap=0.04):
+    """Replay PicoSwitch's controller/keyboard sequence without per-line prompts."""
+    client.require_gamepad()  # Old builds stop here, before any keyboard/gamepad input.
+    client.require_taps()
+    client.request("RELEASE")
+    print("Starting in %g seconds; keep Civ7 chat open. Ctrl-C stops." % countdown, flush=True)
+    wait_with_heartbeat(client, countdown)
+    if preamble:
+        for _ in range(5):
+            tap_pad(client, gap=0.8)
+    end = len(lines) if limit is None else min(len(lines), start + limit - 1)
+    for index in range(start - 1, end):
+        line = lines[index]
+        print("Typing line %d/%d (%d characters)" % (index + 1, len(lines), len(line)), flush=True)
+        tap_key(client, "ESC", gap=0.8)
+        tap_pad(client, gap=1.2)
+        for char in line:
+            mod, key = character_key(char)
+            if 4 <= key <= 29 and client.leds() & 2:
+                mod ^= 2
+            client.tap(make_report(mod, [key]), hold, gap)
+        tap_key(client, "ENTER", gap=0.2)
+        tap_key(client, "ENTER", gap=0)
+        if index + 1 < end:
+            wait_with_heartbeat(client, 0.8)
+            tap_pad(client, gap=1.2)
+    print("Sent lines %d..%d. Check the target console." % (start, end), flush=True)
+
+def send_atomic_text(client, text, gap=0.04, newline_sequence=None):
+    text = text.replace("\r\n", "\n").replace("\r", "\n")
+    keys = [character_key(char) for char in text]
+    client.require_taps()
+    for mod, key in keys:
+        if key == 40 and newline_sequence is not None:
+            for report in newline_sequence:
+                client.tap(report, SEQUENCE_HOLD, gap)
+            continue
+        if 4 <= key <= 29 and client.leds() & 2:
+            mod ^= 2
+        client.tap(make_report(mod, [key]), 0.04, gap)
+
