+        records = self.reports(5)
+        self.assertEqual(records[:3], ["P"+nx.pad_report("A").hex(), nx.RELEASE.hex(), "P"+nx.PAD_NEUTRAL.hex()])
+        self.assertIn("P"+nx.PAD_NEUTRAL.hex(), records[3:])
